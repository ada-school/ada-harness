{
  // Typecheck without compiling. npm run build (tsconfig.build.json) writes dist/, which Node runs.
  // app/ and the tests stay JavaScript, so noImplicitAny stays false here.
  // The engine build uses noImplicitAny (tsconfig.build.json). JSDoc keeps the .js specifier.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": true,
    "noImplicitAny": false,
    "useUnknownInCatchVariables": false,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "harness/tools/**/*.ts", "app/js/**/*.js", "tests/**/*.js"]
}
