{
  "name": "ada-harness",
  "version": "0.1.0",
  "description": "Plantilla mínima de un AI Harness: capas de contexto, loop agéntico, compactación y subagentes, con un chat minimalista. Funciona con Claude, Gemini y modelos locales con Ollama.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/server.js",
    "cli": "node src/harness.js",
    "capas": "node src/cli.js --capas",
    "test": "node tests/run.js",
    "test:unit": "node tests/run.js unit",
    "test:providers": "node tests/run.js providers",
    "test:integration": "node tests/run.js integration",
    "trazabilidad": "node tests/trazabilidad.js",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "6.0.3"
  }
}
