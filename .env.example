# Copia este archivo a .env. Una clave basta. Sin claves, Ollama en local también sirve.
# Las líneas que empiezan con # no se cargan. Lo que ya esté en el entorno no se pisa.

ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# anthropic, gemini u ollama. Vacío: el primero que esté listo.
# ADA_PROVIDER=

# Ruta absoluta del software que el agente construye. Vacío: workspace/ de este repo.
# ADA_WORKSPACE=

# ADA_ANTHROPIC_MODEL=claude-sonnet-5-5
# ADA_ANTHROPIC_FAST_MODEL=claude-haiku-5-5
# ADA_GEMINI_MODEL=gemini-3.8-flash
# ADA_GEMINI_FAST_MODEL=gemini-3.5-flash-lite
# OLLAMA_HOST=http://localhost:11434
# ADA_OLLAMA_MODEL=
# ADA_OLLAMA_FAST_MODEL=
# ADA_OLLAMA_NUM_CTX=16384
# ADA_MEMORY=
# Carpeta del historial del chat. Vacío: .sessions/ de este repo.
# ADA_SESSIONS=
# PORT=3000
# ADA_HOST=127.0.0.1
